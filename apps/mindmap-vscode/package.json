{
  "name": "tnotes-mindmap-vscode",
  "displayName": "TNotes Mindmap",
  "description": "在 VS Code 中编辑 Markdown-first 的 *.tn-mindmap.md 大纲和思维导图",
  "version": "0.1.1",
  "type": "module",
  "publisher": "tnotesjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnotesjs/tnotesjs.git",
    "directory": "apps/mindmap-vscode"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "mindmap",
    "markdown",
    "outline",
    "tnotes"
  ],
  "activationEvents": [
    "onCustomEditor:tnotesMindmap.editor"
  ],
  "main": "./dist/extension.cjs",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "tnotesMindmap.editor",
        "displayName": "TNotes Mindmap",
        "selector": [
          {
            "filenamePattern": "*.tn-mindmap.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "tnotesMindmap.openAsMindmap",
        "title": "TNotes Mindmap: 使用思维导图编辑器打开",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tnotesMindmap.openAsMindmap",
          "when": "resourceFilename =~ /\\.tn-mindmap\\.md$/",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "node ./scripts/build.mjs --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm build",
    "package": "pnpm check && vsce package --no-dependencies"
  },
  "dependencies": {
    "@tnotesjs/mindmap-core": "workspace:^",
    "@tnotesjs/ui": "workspace:^",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.104.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  }
}
