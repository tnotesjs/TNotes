{
  "name": "@tnotesjs/mindmap-web",
  "version": "0.1.0",
  "description": "TNotes 思维导图 Web 应用 —— 数据即 Markdown（*.tn-mindmap.md）",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnotesjs/mindmap-web.git"
  },
  "bugs": {
    "url": "https://github.com/tnotesjs/mindmap-web/issues"
  },
  "homepage": "https://tnotesjs.github.io/mindmap-web/",
  "dependencies": {
    "@tnotesjs/mindmap-core": "^0.2.2",
    "@tnotesjs/ui": "^0.1.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  }
}
