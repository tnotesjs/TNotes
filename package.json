{
  "name": "@tnotesjs/ui",
  "version": "0.1.2",
  "description": "Shared Vue UI for TNotes built-in blocks — consumed by VitePress (core) and Desk.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./footprints-parse": {
      "types": "./src/components/Footprints/parse.ts",
      "import": "./src/components/Footprints/parse.ts",
      "default": "./src/components/Footprints/parse.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@tnotesjs/mindmap-core": "^0.2.2",
    "marked": "^15.0.11",
    "mermaid": "^11.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.12.0",
    "sass": "^1.90.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.25"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnotesjs/ui.git"
  },
  "homepage": "https://github.com/tnotesjs/ui#readme",
  "bugs": {
    "url": "https://github.com/tnotesjs/ui/issues"
  },
  "keywords": [
    "tnotesjs",
    "vue",
    "vitepress",
    "desk"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm typecheck"
  }
}
